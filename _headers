# Cloudflare static-asset headers. The site loads nothing from other origins,
# so the policy below allows only files from the site itself.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), interest-cohort=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# Fonts never change under the same name: cache for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images: cache for a week (a replaced photo with the same file name shows up within 7 days).
/img/*
  Cache-Control: public, max-age=604800

# The preview page must not appear in search results. These two rules stop
# applying by themselves once prod.html is renamed to index.html.
/prod
  X-Robots-Tag: noindex, nofollow
/prod.html
  X-Robots-Tag: noindex, nofollow
